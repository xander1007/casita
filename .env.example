# Variables usadas por docker-compose.yml.
# Copia este archivo como .env y cambia las claves (setup.ps1 / setup.sh
# lo hacen automaticamente y generan claves aleatorias).
# El archivo .env NO se sube al repositorio.

# PostgreSQL (tambien se pasan al contenedor app como DB_*)
DB_DATABASE=casita_erp
DB_USERNAME=root
DB_PASSWORD=cambia_esta_clave

# pgAdmin
PGADMIN_EMAIL=admin@casita.pe
PGADMIN_PASSWORD=cambia_esta_clave
